# ============================================
# CRON / SCHEDULED JOBS
# ============================================
# Shared secret for cron-triggered endpoints (commissions/mature,
# payouts/reconcile, trust/recompute). Generate: openssl rand -base64 32
CRON_SECRET=""

# ============================================
# CRYPTO DISBURSEMENT (Feature B)
# ============================================
# Only required if any program has treasuryType=CRYPTO. The default provider
# is NowPayments (managed Mass Payouts API). For local dev set
# CRYPTO_DISBURSEMENT_PROVIDER=stub to skip any network calls.
#
# NowPayments setup:
#  1. Create an account at https://account.nowpayments.io (sandbox: account-sandbox.nowpayments.io).
#  2. Generate an API key in Settings → API Keys.
#  3. Set the IPN secret in Settings → Store Settings (used to sign callbacks).
#  4. Whitelist your server's egress IP in Settings → Payments → IP Addresses
#     (Cloud NAT recommended for stable Cloud Run egress).
#  5. Email whitelist@nowpayments.io to disable per-batch 2FA on payouts.
CRYPTO_DISBURSEMENT_PROVIDER="nowpayments"
# Sandbox: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_BASE_URL="https://api.nowpayments.io/v1"
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_EMAIL=""
NOWPAYMENTS_PASSWORD=""
# One of: usdttrc20 | usdterc20 | usdtbsc | usdtsol | usdtmatic
NOWPAYMENTS_USDT_NETWORK="usdttrc20"
# IPN signing secret used by /api/webhook/nowpayments to verify incoming
# callbacks (HMAC-SHA512 of the JSON body with sorted top-level keys).
NOWPAYMENTS_IPN_SECRET=""

# ============================================
# TRUST SCORE ATTESTATIONS (Feature E)
# ============================================
# Only required if treasuryType=CRYPTO and trustEnabled=true. With these
# set, /api/admin/trust/recompute signs off-chain EAS attestations and
# stores their UID/signature on each TrustScore row. Without them, trust
# scores are computed but not attested (the rest of the trust flow still
# works locally).
#
# Setup steps (one time):
#   1. Generate an attester wallet (`openssl rand -hex 32` is the
#      private key; derive the address with any wallet tool).
#   2. Fund nothing — off-chain attestations cost zero gas.
#   3. Visit https://easscan.org and register a schema with the layout:
#         bytes32 affiliateIdHash, uint16 score, uint8 tier, bytes32 programIdHash, uint64 computedAt
#      Use the same chain you intend to attest on (Polygon default).
#   4. Paste the schema's UID into EAS_SCHEMA_UID below.
#   5. Pick a unique random salt (`openssl rand -base64 32`) — affiliate
#      IDs are hashed with this salt before being put in attestations,
#      so two Refferq deployments don't leak each other's IDs.
EAS_ATTESTER_PRIVATE_KEY=""
EAS_SCHEMA_UID=""
EAS_ATTESTATION_SALT=""
# EAS contract address + chain ID for the chain your schema is registered on.
# Defaults below are for Polygon mainnet. Common alternatives:
#   Optimism:        0x4200000000000000000000000000000000000021  chainId 10
#   Base:            0x4200000000000000000000000000000000000021  chainId 8453
#   Sepolia testnet: 0xC2679fBD37d54388Ce493F1DB75320D236e1815e  chainId 11155111
EAS_CONTRACT_ADDRESS="0x5E634ef5355f45A855d02D66eCD687b1502AF790"
EAS_CHAIN_ID="137"
EAS_OFFCHAIN_ENDPOINT="https://offchain.attest.sh"

